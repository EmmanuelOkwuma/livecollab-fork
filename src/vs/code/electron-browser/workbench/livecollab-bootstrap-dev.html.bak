<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src http://localhost:4000;">
	<title>LiveCollab</title>
	<style>
		* { margin: 0; padding: 0; box-sizing: border-box; }
		html, body { width: 100%; height: 100%; background: #181818; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif; color: #CCCCCC; overflow: hidden; }

		/* ── LANDING ── */
		#page-landing { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; background: #181818; }
		.land-col { display: flex; flex-direction: column; align-items: flex-start; width: 360px; }
		.land-logo { width: 64px; height: 64px; margin-bottom: 20px; }
		.land-name { font-size: 30px; font-weight: 700; color: #CCCCCC; letter-spacing: -0.5px; margin-bottom: 4px; }
		.land-tag  { font-size: 16px; color: #9D9D9D; margin-bottom: 36px; line-height: 1.4; }
		.land-btn  { width: 100%; height: 38px; display: flex; align-items: center; justify-content: center; border-radius: 6px; cursor: pointer; font-size: 14px; font-weight: 500; border: 1px solid transparent; transition: background 120ms; margin-bottom: 8px; user-select: none; }
		.land-signin { background: #2F5C8A; border-color: #356399; color: #fff; }
		.land-signin:hover { background: #356BA0; box-shadow: 0 0 0 2px rgba(0,122,204,.35); }
		.land-signup { background: #2A2D34; border-color: #3A3F47; color: #E4E4E4; }
		.land-signup:hover { background: #32363E; border-color: #007ACC; box-shadow: 0 0 0 1px rgba(0,122,204,.2); }

		/* ── AUTH PAGES (sign-in / sign-up) ── */
		#page-signin, #page-signup { position: fixed; inset: 0; background: #181818; display: none; }

		/* top-left wordmark */
		.wm { position: absolute; top: 30px; left: 34px; display: flex; align-items: center; gap: 2px; }
		.wm-name { font-size: 18px; font-weight: 700; letter-spacing: 1px; color: #E4E4E4; }

		/* centered form column */
		.auth-col { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
		.auth-form { width: 430px; display: flex; flex-direction: column; }
		.auth-title { font-size: 30px; font-weight: 600; color: #F2F2F2; margin-bottom: 6px; }
		.auth-sub   { font-size: 21px; color: #5C5C5C; margin-bottom: 28px; }

		/* oauth buttons */
		.oauth-btn { width: 100%; padding: 13px; display: flex; align-items: center; justify-content: center; gap: 10px; background: #1E1E1E; border: 1px solid #2B2B2B; border-radius: 8px; color: #E4E4E4; font-size: 13px; cursor: pointer; margin-bottom: 12px; position: relative; transition: background 120ms; user-select: none; }
		.oauth-btn:hover { background: #232323; border-color: #007ACC; box-shadow: 0 0 0 1px rgba(0,122,204,.25); }
		.last-used { position: absolute; top: -13px; right: 10px; background: #1E1E1E; border: 1px solid #3A3A3A; color: #9D9D9D; font-size: 11px; padding: 2px 8px; border-radius: 4px; }

		/* divider */
		.divider { display: flex; align-items: center; gap: 12px; margin: 4px 0 16px; color: #3A3A3A; font-size: 13px; }
		.divider::before, .divider::after { content: ""; flex: 1; height: 1px; background: #2B2B2B; }

		/* inputs */
		.input-row { display: flex; gap: 14px; margin-bottom: 14px; }
		.input-group { display: flex; flex-direction: column; flex: 1; }
		.input-label { font-size: 13px; color: #7A7A7A; margin-bottom: 6px; }
		.auth-input { width: 100%; padding: 11px 13px; background: #181818; border: 1px solid #2B2B2B; border-radius: 8px; color: #E4E4E4; font-size: 14px; outline: none; transition: border-color 120ms; }
		.auth-input::placeholder { color: #4A4A4A; }
		.auth-input:focus { border-color: #007ACC; box-shadow: 0 0 0 3px rgba(0,122,204,.15); }
		.input-full { margin-bottom: 14px; }

		/* continue button */
		.continue-btn { width: 100%; padding: 13px; background: #1E1E1E; border: 1px solid #2B2B2B; border-radius: 8px; color: #F2F2F2; font-size: 14px; font-weight: 500; cursor: pointer; transition: background 120ms; margin-top: 4px; margin-bottom: 18px; user-select: none; text-align: center; }
		.continue-btn:hover { background: #232323; border-color: #007ACC; box-shadow: 0 0 0 1px rgba(0,122,204,.25); }

		/* switch link */
		.switch { text-align: center; font-size: 15px; color: #7A7A7A; }
		.switch a { color: #B8B8B8; text-decoration: none; cursor: pointer; }
		.switch a:hover { text-decoration: underline; }

		/* footer */
		.auth-foot { position: absolute; bottom: 30px; left: 0; right: 0; text-align: center; font-size: 13px; color: #5C5C5C; }
		.auth-foot a { color: #7A7A7A; text-decoration: underline; cursor: pointer; }
		.auth-foot a:hover { color: #A8A8A8; }

		/* footer on landing */
		.land-foot { position: fixed; bottom: 24px; left: 0; right: 0; text-align: center; font-size: 12px; color: #8A8A8A; }

		/* flat mark SVG helper */
		.mark-sm { width: 38px; height: 38px; }
	
		/* ── DESCRIBE YOU ── */
		#page-describe { position: fixed; inset: 0; background: #181818; display: none; }
		.desc-col { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 0; }
		.desc-title { font-size: 28px; font-weight: 700; color: #F2F2F2; margin-bottom: 8px; text-align: center; }
		.desc-sub { font-size: 14px; color: #9D9D9D; margin-bottom: 4px; text-align: center; }
		.desc-hint { font-size: 12px; color: #6E6E6E; margin-bottom: 28px; text-align: center; }
		.desc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; width: 560px; margin-bottom: 28px; }
		.desc-card { background: #161616; border: 1px solid #2B2B2B; border-radius: 10px; padding: 22px; display: flex; flex-direction: column; align-items: center; gap: 10px; cursor: pointer; position: relative; transition: background 150ms, border-color 150ms, transform 150ms, box-shadow 150ms; user-select: none; }
		.desc-card:hover { background: #1C1C1C; border-color: #3A3A3A; transform: translateY(-2px); }
		.desc-card.selected { background: #10212E; border-color: #007ACC; box-shadow: 0 0 0 1px rgba(0,122,204,.4); }
		.desc-card.selected .desc-icon { color: #3F8FD0; }
		.desc-check { position: absolute; top: 10px; right: 12px; color: #007ACC; font-size: 14px; opacity: 0; transform: scale(.6); transition: opacity .15s, transform .15s; }
		.desc-card.selected .desc-check { opacity: 1; transform: scale(1); }
		.desc-icon { font-size: 30px; color: #9D9D9D; }
		.desc-card-title { font-size: 14px; font-weight: 600; color: #CCCCCC; }
		.desc-card-desc { font-size: 11px; color: #6E6E6E; text-align: center; line-height: 1.5; }
		.desc-skip { font-size: 14px; color: #9D9D9D; cursor: pointer; padding: 8px 20px; border-radius: 6px; transition: color 120ms, background 120ms; }
		.desc-skip:hover { color: #E4E4E4; background: #161616; }
	
			#si-stay-toggle.off { background: #3A3A3A; }
		#si-stay-toggle.off #si-stay-knob { left: 19px; }
		#si-stay-toggle:not(.off) #si-stay-knob { left: 3px; }
			.pwd-wrap { position: relative; margin-bottom: 0; }
		.pwd-wrap .auth-input { padding-right: 40px; margin-bottom: 0; }
		.pwd-eye { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #6E6E6E; font-size: 16px; user-select: none; line-height: 1; }
		.pwd-eye:hover { color: #9D9D9D; }
	</style>
</head>
<body>

<!-- ══════════════ LANDING ══════════════ -->
<div id="page-landing">
	<div class="land-col">
		<svg class="land-logo" viewBox="0 0 110 110" fill="none" xmlns="http://www.w3.org/2000/svg">
			<defs>
				<linearGradient id="bp" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2E6BE6"/><stop offset="1" stop-color="#13255C"/></linearGradient>
				<linearGradient id="sp" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4D9FFF"/><stop offset="1" stop-color="#1D5FD6"/></linearGradient>
			</defs>
			<g transform="translate(11,14) scale(0.92)">
				<circle cx="34" cy="24" r="11" fill="url(#bp)"/>
				<rect x="28.5" y="24" width="11" height="50" rx="5.5" fill="url(#bp)"/>
				<circle cx="62" cy="38" r="8.5" fill="url(#sp)"/>
				<rect x="57.75" y="38" width="8.5" height="36" rx="4.25" fill="url(#sp)"/>
			</g>
		</svg>
		<div class="land-name">LiveCollab</div>
		<div class="land-tag">Code together, in real time</div>
		<div class="land-btn land-signin" id="go-signin">Sign In</div>
		<div class="land-btn land-signup" id="go-signup">Sign Up</div>
	</div>
	<div class="land-foot">Live collaboration features require you to be signed in.</div>
</div>

<!-- ══════════════ SIGN IN ══════════════ -->
<div id="page-signin">
	<div class="wm">
		<svg class="mark-sm" viewBox="0 0 110 110" fill="none" xmlns="http://www.w3.org/2000/svg">
			<g transform="translate(11,14) scale(0.92)">
				<circle cx="34" cy="24" r="11" fill="#2563EB"/>
				<rect x="28.5" y="24" width="11" height="50" rx="5.5" fill="#2563EB"/>
				<circle cx="62" cy="38" r="8.5" fill="#60A5FA"/>
				<rect x="57.75" y="38" width="8.5" height="36" rx="4.25" fill="#60A5FA"/>
			</g>
		</svg>
		<span class="wm-name">LiveCollab</span>
	</div>
	<div class="auth-col">
		<div class="auth-form">
			<div class="auth-title">Welcome back</div>
			<div class="auth-sub">Pick up where you left off</div>
			<div class="oauth-btn" id="si-google">
				<svg width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
				Continue with Google
				<span class="last-used" id="si-last-used" style="display:none">Last used</span>
			</div>
			<div class="oauth-btn">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="#E4E4E4"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
				Continue with GitHub
			</div>
			<div class="oauth-btn">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="#E4E4E4"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
				Continue with Apple
			</div>
			<div class="divider">or</div>
			<div class="input-group input-full">
				<div class="input-label">Email</div>
				<input class="auth-input" type="email" placeholder="you@example.com" id="si-email"/>
			</div>
			<div class="input-label">Password</div>
			<div class="pwd-wrap" style="margin-bottom:6px;"><input class="auth-input" type="password" placeholder="••••••••" id="si-password"/><span class="pwd-eye" onclick="togglePwd('si-password',this)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></span></div>
			<div style="text-align:right;margin-bottom:14px;">
				<a id="go-forgot" style="font-size:12px;color:#3F8FD0;cursor:pointer;text-decoration:none;">Forgot password?</a>
			</div>
			<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
				<span style="font-size:12px;color:#9D9D9D;">Stay signed in on this device</span>
				<div id="si-stay-toggle" onclick="this.classList.toggle('off')" style="width:36px;height:20px;border-radius:10px;background:#007ACC;cursor:pointer;position:relative;transition:background 200ms;flex-shrink:0;">
					<div style="position:absolute;top:3px;left:3px;width:14px;height:14px;border-radius:50%;background:#fff;transition:left 200ms;" id="si-stay-knob"></div>
				</div>
			</div>
			<div id="si-error" style="color:#F14C4C;font-size:12px;margin-bottom:8px;display:none;"></div>
			<div class="continue-btn" id="si-continue" style="text-align:center">Sign in</div>
			<div class="switch">Don't have an account? <a id="go-signup-from-signin">Sign up</a></div>
		</div>
	</div>
	<div class="auth-foot"><a href="#">Terms of Service</a> &nbsp;·&nbsp; <a href="#">Privacy Policy</a></div>
</div>

<!-- ══════════════ SIGN UP ══════════════ -->
<div id="page-signup">
	<div class="wm">
		<svg class="mark-sm" viewBox="0 0 110 110" fill="none" xmlns="http://www.w3.org/2000/svg">
			<g transform="translate(11,14) scale(0.92)">
				<circle cx="34" cy="24" r="11" fill="#2563EB"/>
				<rect x="28.5" y="24" width="11" height="50" rx="5.5" fill="#2563EB"/>
				<circle cx="62" cy="38" r="8.5" fill="#60A5FA"/>
				<rect x="57.75" y="38" width="8.5" height="36" rx="4.25" fill="#60A5FA"/>
			</g>
		</svg>
		<span class="wm-name">LiveCollab</span>
	</div>
	<div class="auth-col">
		<div class="auth-form">
			<div class="auth-title">Welcome to LiveCollab</div>
			<div class="auth-sub">The new way to collaborate</div>
			<div class="oauth-btn">
				<svg width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
				Continue with Google
			</div>
			<div class="oauth-btn">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="#E4E4E4"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
				Continue with GitHub
			</div>
			<div class="oauth-btn">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="#E4E4E4"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
				Continue with Apple
			</div>
			<div class="divider">or</div>
			<div class="input-group input-full">
				<div class="input-label">Email</div>
				<input class="auth-input" type="email" placeholder="Your email address" id="su-email"/>
			</div>
			<div class="input-group input-full">
				<div class="input-label">Password</div>
				<div class="pwd-wrap"><input class="auth-input" type="password" placeholder="Create a password" id="su-password"/><span class="pwd-eye" onclick="togglePwd('su-password',this)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></span></div>
				<div id="su-checklist" style="display:none;margin-top:6px;margin-bottom:4px;flex-direction:column;gap:4px;">
					<div id="su-chk-len" style="font-size:11px;color:#6E6E6E;">• At least 8 characters</div>
					<div id="su-chk-num" style="font-size:11px;color:#6E6E6E;">• One number</div>
					<div id="su-chk-upper" style="font-size:11px;color:#6E6E6E;">• One uppercase letter</div>
				</div>
			</div>
			<div class="input-group input-full">
				<div class="input-label">Confirm password</div>
				<div class="pwd-wrap"><input class="auth-input" type="password" placeholder="Re-enter password" id="su-confirm"/><span class="pwd-eye" onclick="togglePwd('su-confirm',this)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></span></div>
			</div>
			<div class="continue-btn" id="su-continue">Create account</div>
			<div class="switch">Already have an account? <a id="go-signin-from-signup">Sign in</a></div>
		</div>
	</div>
	<div class="auth-foot">By creating an account, you agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.</div>
</div>



<!-- ══════════════ DESCRIBE YOU ══════════════ -->
<div id="page-describe">
	<div class="wm">
		<svg class="mark-sm" viewBox="0 0 110 110" fill="none" xmlns="http://www.w3.org/2000/svg">
			<g transform="translate(11,14) scale(0.92)">
				<circle cx="34" cy="24" r="11" fill="#2563EB"/>
				<rect x="28.5" y="24" width="11" height="50" rx="5.5" fill="#2563EB"/>
				<circle cx="62" cy="38" r="8.5" fill="#60A5FA"/>
				<rect x="57.75" y="38" width="8.5" height="36" rx="4.25" fill="#60A5FA"/>
			</g>
		</svg>
		<span class="wm-name">LiveCollab</span>
	</div>
	<div class="desc-col">
		<div class="desc-title">What best describes you?</div>
		<div class="desc-sub">This helps us tailor <span style="color:#007ACC;font-weight:700">LiveCollab</span> to how you work.</div>
		<div style="height:28px"></div>
		<div class="desc-grid">
			<div class="desc-card" data-type="student">
				<span class="desc-check">✓</span>
				
				<div class="desc-card-title">Student</div>
				<div class="desc-card-desc">Coursework, group projects, and learning to code</div>
			</div>
			<div class="desc-card" data-type="developer">
				<span class="desc-check">✓</span>
				
				<div class="desc-card-title">Developer</div>
				<div class="desc-card-desc">Professional or freelance coding</div>
			</div>
			<div class="desc-card" data-type="team">
				<span class="desc-check">✓</span>
				
				<div class="desc-card-title">Team / Lead</div>
				<div class="desc-card-desc">Building and shipping with a team</div>
			</div>
			<div class="desc-card" data-type="hobbyist">
				<span class="desc-check">✓</span>
				
				<div class="desc-card-title">Hobbyist</div>
				<div class="desc-card-desc">Side projects and exploring new ideas</div>
			</div>
		</div>
		<div class="desc-skip" id="desc-skip">Skip</div>
	</div>
</div>


<!-- PAGE A: Reset your password -->
<div id="page-reset-a" style="position:fixed;inset:0;background:#181818;display:none;">
	<div style="position:absolute;top:30px;left:34px;font-size:13px;color:#9D9D9D;cursor:pointer;" id="reset-a-back">← Back to sign in</div>
	<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;">
		<div style="width:430px;display:flex;flex-direction:column;">
			<div style="font-size:28px;font-weight:600;color:#F2F2F2;margin-bottom:6px;">Reset your password</div>
			<div style="font-size:18px;color:#5C5C5C;margin-bottom:28px;">Enter your email and we’ll send you a reset link.</div>
			<div id="reset-a-form">
				<div class="input-label">Email</div>
				<input class="auth-input" type="email" id="reset-a-email" placeholder="you@example.com" style="margin-bottom:14px;"/>
				<div id="reset-a-error" style="color:#F14C4C;font-size:12px;margin-bottom:8px;display:none;"></div>
				<div class="continue-btn" id="reset-a-submit">Send reset link</div>
			</div>
			<div id="reset-a-success" style="display:none;">
				<div style="color:#2EA043;font-size:14px;margin-bottom:20px;" id="reset-a-msg"></div>
				<div class="continue-btn" id="reset-a-to-b" style="margin-bottom:10px;">Set new password →</div>
				<div class="continue-btn" id="reset-a-resend" disabled style="opacity:0.5;cursor:not-allowed;">Resend in 0:45</div>
			</div>
		</div>
	</div>
</div>

<!-- PAGE B: Set a new password -->
<div id="page-reset-b" style="position:fixed;inset:0;background:#181818;display:none;">
	<div style="position:absolute;top:30px;left:34px;font-size:13px;color:#9D9D9D;cursor:pointer;" id="reset-b-back">← Back to sign in</div>
	<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;">
		<div style="width:430px;display:flex;flex-direction:column;">
			<div style="font-size:28px;font-weight:600;color:#F2F2F2;margin-bottom:6px;">Set a new password</div>
			<div style="font-size:18px;color:#5C5C5C;margin-bottom:28px;">Choose something you’ll remember.</div>
			<div id="reset-b-form">
				<div class="input-label">New password</div>
				<div class="pwd-wrap" style="margin-bottom:6px;">
					<input class="auth-input" type="password" id="reset-b-pwd" placeholder="New password"/>
					<span class="pwd-eye" onclick="togglePwd('reset-b-pwd',this)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></span>
				</div>
				<div id="reset-b-checklist" style="display:none;margin-bottom:14px;flex-direction:column;gap:4px;">
					<div id="reset-b-chk-len" style="font-size:11px;color:#6E6E6E;">• At least 8 characters</div>
					<div id="reset-b-chk-num" style="font-size:11px;color:#6E6E6E;">• One number</div>
					<div id="reset-b-chk-upper" style="font-size:11px;color:#6E6E6E;">• One uppercase letter</div>
				</div>
				<div class="input-label">Confirm new password</div>
				<div class="pwd-wrap" style="margin-bottom:14px;">
					<input class="auth-input" type="password" id="reset-b-confirm" placeholder="Re-enter new password"/>
					<span class="pwd-eye" onclick="togglePwd('reset-b-confirm',this)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></span>
				</div>
				<div id="reset-b-error" style="color:#F14C4C;font-size:12px;margin-bottom:8px;display:none;"></div>
				<div class="continue-btn" id="reset-b-submit">Update password</div>
			</div>
			<div id="reset-b-success" style="display:none;">
				<div style="color:#2EA043;font-size:14px;margin-bottom:20px;">Password updated. You can now sign in with your new password.</div>
				<div class="continue-btn" id="reset-b-to-signin">Back to sign in</div>
			</div>
		</div>
	</div>
</div>

<script>
	// ── Page router ──
	function show(id) {
		['page-landing','page-signin','page-signup','page-describe','page-reset-a','page-reset-b'].forEach(p => {
			document.getElementById(p).style.display = p === id ? (p === 'page-landing' ? 'flex' : 'block') : 'none';
		});
	}

	document.getElementById('go-signin').onclick = () => show('page-signin');
	document.getElementById('go-signup').onclick = () => show('page-signup');
	document.getElementById('go-signup-from-signin').onclick = () => show('page-signup');
	document.getElementById('go-signin-from-signup').onclick = () => show('page-signin');

	
	// ── Describe you (wired after DOM ready) ──
	window.addEventListener('DOMContentLoaded', () => {
		document.querySelectorAll('.desc-card').forEach(card => {
			card.addEventListener('click', () => card.classList.toggle('selected'));
		});
		document.getElementById('desc-skip').addEventListener('click', () => {
			const selected = [...document.querySelectorAll('.desc-card.selected')].map(c => c.dataset.type);
			console.log('user types:', selected);
			show('page-landing');
		});
		const suContinue = document.getElementById('su-continue');

		if (suContinue) suContinue.addEventListener('click', () => show('page-describe'));
	});

	// ── Signal main process: page is painted, show the window ──
	window.addEventListener('DOMContentLoaded', () => {
		requestAnimationFrame(() => requestAnimationFrame(() => {
			window.vscode?.ipcRenderer?.send('vscode:livecollab-ready');
		}));
	});

	// ── AUTH WIRING ──
	const SERVER = 'http://localhost:4000';

	async function storeToken(token) {
		if (window.vscode?.ipcRenderer) {
			window.vscode.ipcRenderer.send('vscode:livecollab-store-token', token);
		}
	}

	// Sign In
	window.addEventListener('DOMContentLoaded', () => {
		const siContinue = document.getElementById('si-continue');
		if (siContinue) {
			siContinue.addEventListener('click', async () => {
				const email = document.getElementById('si-email').value.trim();
				const password = document.getElementById('si-password').value;
				const err = document.getElementById('si-error');
				err.style.display = 'none';
				if (!email || !password) { err.textContent = 'Please enter your email and password.'; err.style.display = 'block'; return; }
				siContinue.textContent = 'Signing in…';
				try {
					const res = await fetch(SERVER + '/auth/login', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ email, password })
					});
					const text = await res.text();
					if (!res.ok) {
						err.textContent = text === 'invalid_credentials' ? 'Incorrect email or password.' : 'Something went wrong. Try again.';
						err.style.display = 'block';
						siContinue.textContent = 'Continue';
						return;
					}
					const { token } = JSON.parse(text);
					await storeToken(token);
					show('page-describe');
				} catch {
					err.textContent = 'Could not reach the server. Is it running?';
					err.style.display = 'block';
					siContinue.textContent = 'Continue';
				}
			});
		}

		// Sign Up
		const suContinue = document.getElementById('su-continue');
		if (suContinue) {
			suContinue.addEventListener('click', async () => {
				const email = document.getElementById('su-email').value.trim();
				const password = document.getElementById('su-password').value;
				const err = document.getElementById('su-error');
				err.style.display = 'none';
				if (!email || !password) { err.textContent = 'Please enter your email and password.'; err.style.display = 'block'; return; }
				suContinue.textContent = 'Creating account…';
				try {
					const res = await fetch(SERVER + '/auth/register', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ email, password })
					});
					const text = await res.text();
					if (!res.ok) {
						err.textContent = text === 'user_exists' ? 'An account with this email already exists. Sign in instead.' : 'Something went wrong. Try again.';
						err.style.display = 'block';
						suContinue.textContent = 'Continue';
						return;
					}
					const { token } = JSON.parse(text);
					await storeToken(token);
					show('page-describe');
				} catch {
					err.textContent = 'Could not reach the server. Is it running?';
					err.style.display = 'block';
					suContinue.textContent = 'Continue';
				}
			});
		}
	});


	function togglePwd(id, eye) {
		const inp = document.getElementById(id);
		if (!inp) return;
		const show = inp.type === 'password';
		inp.type = show ? 'text' : 'password';
		eye.style.color = show ? '#007ACC' : '#6E6E6E';
		eye.innerHTML = show ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>' : '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
	}

	// Password checklist — shows on focus, hides when all met and user leaves
	const suPwd = document.getElementById('su-password');
	if (suPwd) {
		const cl = document.getElementById('su-checklist');
		function updateChecklist() {
			const v = suPwd.value;
			const lenOk = v.length >= 8, numOk = /[0-9]/.test(v), upOk = /[A-Z]/.test(v);
			function setChk(id, ok) { const el = document.getElementById(id); if (!el) return; el.style.color = ok ? '#2EA043' : '#6E6E6E'; el.textContent = (ok ? '\u2713' : '\u2022') + ' ' + el.textContent.slice(2); }
			setChk('su-chk-len', lenOk); setChk('su-chk-num', numOk); setChk('su-chk-upper', upOk);
			return lenOk && numOk && upOk;
		}
		suPwd.addEventListener('focus', () => { if (cl) { cl.style.display = 'flex'; } });
		suPwd.addEventListener('blur', () => { if (cl && updateChecklist()) cl.style.display = 'none'; });
		suPwd.addEventListener('input', function() {
			const v = this.value;
			function setChk(id, ok) {
				const el = document.getElementById(id);
				if (!el) return;
				el.style.color = ok ? '#2EA043' : '#6E6E6E';
				el.textContent = (ok ? '\u2713' : '\u2022') + ' ' + el.textContent.slice(2);
			}
			updateChecklist();
		});
	}
	
	// Reset page navigation
	document.getElementById('reset-a-back').onclick = () => show('page-signin');
	document.getElementById('reset-b-back').onclick = () => show('page-signin');
	document.getElementById('reset-b-to-signin').onclick = () => show('page-signin');


	// Reset A: send link
	let resetCooldown;
	document.getElementById('reset-a-submit').addEventListener('click', async function() {
		const email = document.getElementById('reset-a-email').value.trim();
		const err = document.getElementById('reset-a-error');
		err.style.display = 'none';
		if (!email || !email.includes('@')) { err.textContent = 'Please enter a valid email.'; err.style.display = 'block'; return; }
		this.textContent = 'Sending…';
		try {
			await fetch('http://localhost:4000/auth/forgot-password', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({email}) });
			document.getElementById('reset-a-form').style.display = 'none';
			const suc = document.getElementById('reset-a-success');
			suc.style.display = 'block';
			document.getElementById('reset-a-msg').textContent = 'Check your email — we sent a reset link to ' + email + '.';
			startResetCooldown();
		} catch {
			err.textContent = 'Could not reach the server. Is it running?';
			err.style.display = 'block';
			this.textContent = 'Send reset link';
		}
	});
	function startResetCooldown() {
		const btn = document.getElementById('reset-a-resend');
		let secs = 45;
		btn.disabled = true; btn.style.opacity = '0.5'; btn.style.cursor = 'not-allowed';
		btn.textContent = 'Resend in 0:' + String(secs).padStart(2,'0');
		clearInterval(resetCooldown);
		resetCooldown = setInterval(() => {
			secs--;
			if (secs <= 0) { clearInterval(resetCooldown); btn.disabled = false; btn.style.opacity = '1'; btn.style.cursor = 'pointer'; btn.textContent = 'Resend'; return; }
			btn.textContent = 'Resend in 0:' + String(secs).padStart(2,'0');
		}, 1000);
	}
	document.getElementById('reset-a-resend').addEventListener('click', function() {
		if (this.disabled) return;
		startResetCooldown();
		// TODO: re-send request
	});

	// Reset B: new password checklist
	const resetPwd = document.getElementById('reset-b-pwd');
	if (resetPwd) {
		const rcl = document.getElementById('reset-b-checklist');
		function updateResetChecklist() {
			const v = resetPwd.value;
			const lenOk = v.length >= 8, numOk = /[0-9]/.test(v), upOk = /[A-Z]/.test(v);
			function setR(id, ok) { const el = document.getElementById(id); if (!el) return; el.style.color = ok ? '#2EA043' : '#6E6E6E'; el.textContent = (ok ? '\u2713' : '\u2022') + ' ' + el.textContent.slice(2); }
			setR('reset-b-chk-len', lenOk); setR('reset-b-chk-num', numOk); setR('reset-b-chk-upper', upOk);
			return lenOk && numOk && upOk;
		}
		resetPwd.addEventListener('focus', () => { if (rcl) rcl.style.display = 'flex'; });
		resetPwd.addEventListener('blur', () => { if (rcl && updateResetChecklist()) rcl.style.display = 'none'; });
		resetPwd.addEventListener('input', updateResetChecklist);
	}

	// Reset B: submit
	document.getElementById('reset-b-submit').addEventListener('click', async function() {
		const pwd = document.getElementById('reset-b-pwd').value;
		const confirm = document.getElementById('reset-b-confirm').value;
		const err = document.getElementById('reset-b-error');
		err.style.display = 'none';
		if (pwd.length < 8 || !/[0-9]/.test(pwd) || !/[A-Z]/.test(pwd)) { err.textContent = 'Password does not meet requirements.'; err.style.display = 'block'; return; }
		if (pwd !== confirm) { err.textContent = 'Passwords do not match.'; err.style.display = 'block'; return; }
		const token = window._resetToken;
		if (!token) { err.textContent = 'Invalid reset link. Please request a new one.'; err.style.display = 'block'; return; }
		this.textContent = 'Updating…';
		try {
			const res = await fetch('http://localhost:4000/auth/reset-password', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({token, newPassword: pwd}) });
			const text = await res.text();
			if (!res.ok) { err.textContent = text === 'expired_token' ? 'This link has expired. Please request a new one.' : 'Something went wrong.'; err.style.display = 'block'; this.textContent = 'Update password'; return; }
			document.getElementById('reset-b-form').style.display = 'none';
			document.getElementById('reset-b-success').style.display = 'block';
		} catch {
			err.textContent = 'Could not reach the server. Is it running?';
			err.style.display = 'block';
			this.textContent = 'Update password';
		}
	});

	// wire forgot after all elements exist
	document.getElementById('go-forgot').onclick = () => show('page-reset-a');
	document.getElementById('reset-a-back').onclick = () => show('page-signin');
	document.getElementById('reset-b-back').onclick = () => show('page-signin');
	document.getElementById('reset-b-to-signin').onclick = () => show('page-signin');
	// livecollab: listen for reset-password deep link token from main process
	// Fires when user clicks the reset link while app is already open
	if (window.vscode?.ipcRenderer) {
		window.vscode.ipcRenderer.on('vscode:livecollab-reset-token', (_event, token) => {
			window._resetToken = token;
			// Validate token then show Page B
			fetch('http://localhost:4000/auth/validate-reset-token?token=' + encodeURIComponent(token))
				.then(r => r.json())
				.then(data => {
					if (data.valid) {
						show('page-reset-b');
					} else {
						// Token expired or invalid — send to Page A with message
						show('page-reset-a');
						const err = document.getElementById('reset-a-error');
						if (err) { err.textContent = 'This reset link has expired. Please request a new one.'; err.style.display = 'block'; }
					}
				})
				.catch(() => show('page-reset-a'));
		});

		// Cold start: check if main process has a pending reset token
		window.vscode.ipcRenderer.invoke('vscode:livecollab-get-pending-reset-token')
			.then(token => {
				if (token) {
					window._resetToken = token;
					fetch('http://localhost:4000/auth/validate-reset-token?token=' + encodeURIComponent(token))
						.then(r => r.json())
						.then(data => { if (data.valid) show('page-reset-b'); else show('page-reset-a'); })
						.catch(() => show('page-reset-a'));
				}
			})
			.catch(() => {});
	}

	</script>
</body>
</html>